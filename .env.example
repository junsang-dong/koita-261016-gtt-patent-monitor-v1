# Neon Postgres (Vercel Marketplace 통합 시 자동 주입)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# KIPRIS Plus Open API 인증키 (포털 발급 키를 그대로 붙여넣기 — 인코딩 여부 무관)
KIPRIS_PLUS_API_KEY=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Vercel Cron 요청 검증 (16자 이상 무작위 문자열)
CRON_SECRET=

# 시연용 로그인 / 세션 쿠키 서명
APP_PASSWORD=
SESSION_SECRET=

# 알림 (선택)
NOTIFY_SLACK_WEBHOOK=
